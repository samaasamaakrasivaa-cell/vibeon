// VibeOn — модель данных (см. Архитектура_и_стек.md)
// Этап 1: полная схема основных сущностей. Логика появится на следующих этапах.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Пользователи и вход ─────────────

enum Role {
  TEACHER
  STUDENT
}

enum Lang {
  RU
  EN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  lastName        String?
  role            Role
  lang            Lang      @default(RU)
  timezone        String    @default("Europe/Moscow")
  telegramChatId  String?
  phone           String?
  consentAt       DateTime? // согласие на обработку ПД (152-ФЗ)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacherProfile TeacherProfile?
  studentRecord  Student?        @relation("StudentUser")
  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  authTokens     AuthToken[]
  notifications  Notification[]
  sentMessages   Message[]       @relation("MessageSender")
  notes          Note[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String // yandex | vk
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum AuthTokenType {
  VERIFY_EMAIL
  MAGIC_LINK
  RESET_PASSWORD
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Tariff {
  TRIAL
  START
  PRO
}

model TeacherProfile {
  userId     String    @id
  tariff     Tariff    @default(TRIAL)
  trialUntil DateTime?
  callLink   String? // внешняя ссылка на звонок (Телемост / Zoom / Meet)
  settings   Json      @default("{}")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  students Student[]
  invites  Invite[]
  courses  Course[]
  groups   Group[]
}

// ───────────── Ученики ─────────────

enum StudentStatus {
  INVITED
  ACTIVE
  ARCHIVED
}

enum PayType {
  PACK
  POSTPAID
}

model Student {
  id              String        @id @default(cuid())
  userId          String?       @unique
  teacherId       String
  name            String
  lastName        String?
  email           String?
  telegram        String?
  status          StudentStatus @default(INVITED)
  form            Json          @default("{}") // стартовая анкета
  payType         PayType       @default(POSTPAID)
  price           Int? // цена урока, ₽
  payerName       String?
  payerContact    String?
  billRule        String? // pack_left_1 | pack_left_2 | pack_end | after_5 | after_15 | after_30 | after_60 | next_day | every_4_weeks | manual
  remindEveryDays Int?
  packPrices      Json          @default("[]") // [{ n: 4, price: 11600 }, …]
  timezone        String        @default("Europe/Moscow")
  callLink        String?
  course          String? // до этапа 4 — текстом
  level           String?
  interests       String?
  examGoal        String?
  source          String? // откуда пришёл
  birthday        DateTime?
  startedAt       DateTime?
  privateNote     String? // заметки учителя, видит только он
  courseId        String? // ведущий курс ученика
  wordGoal        Int           @default(15) // слов в день
  wordDays        Int[]         @default([0, 1, 2, 3, 4]) // дни тренировок: 0 = Пн … 6 = Вс
  remindAt        String        @default("19:00") // время напоминания (Telegram — этап 10)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user      User?            @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  teacher   TeacherProfile   @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  invites   Invite[]
  groups    GroupMember[]
  lessons   LessonInstance[]
  answers   Answer[]
  words     Word[]
  roadmaps  Roadmap[]
  packs     Pack[]
  invoices  Invoice[]
  messages  Message[]
  questions Question[]
  feedback  Feedback[]
  practice  WordPractice[]

  @@index([teacherId, status])
}

model Group {
  id        String           @id @default(cuid())
  teacherId String
  title     String
  createdAt DateTime         @default(now())
  teacher   TeacherProfile   @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  members   GroupMember[]
  lessons   LessonInstance[]
}

model GroupMember {
  groupId   String
  studentId String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
}

enum InviteChannel {
  EMAIL
  TELEGRAM
}

model Invite {
  id        String         @id @default(cuid())
  teacherId String
  studentId String
  token     String         @unique
  channel   InviteChannel
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ───────────── Курсы и уроки ─────────────

model Course {
  id        String         @id @default(cuid())
  teacherId String
  title     String
  level     String?
  category  String? // general | grammar | vocabulary | exams | ege_oge | speaking | business | kids
  audience  String?
  cover     String?
  color     Int      @default(0) // цвет обложки, если картинки нет
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  units     Unit[]
}

model Unit {
  id       String           @id @default(cuid())
  courseId String
  title    String
  order    Int              @default(0)
  outcomes String[]
  collapsed Boolean @default(false)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  LessonTemplate[]
}

model LessonTemplate {
  id         String           @id @default(cuid())
  unitId     String
  title      String
  order      Int              @default(0)
  sections   Json             @default("[]") // секции урока: Урок / Домашка / Новые слова + рубрики
  subtitle    String? // «Vocabulary: work»
  durationMin Int      @default(60)
  outcomes    String[] // «После урока ученик сможет»
  shareOn     Boolean  @default(false)
  shareToken String?          @unique // гостевая ссылка «Поделиться»
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  unit       Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tasks      Task[]
  instances  LessonInstance[]
}

model Task {
  id         String         @id @default(cuid())
  templateId String
  section    String         @default("lesson") // lesson | homework | words
  rubricId   String? // рубрика части «Урок» (Lead-in, Vocabulary…)
  type       String
  title      String
  content    String         @default("") // разметка, см. Разметка_заданий.md
  options    Json           @default("{}")
  hidden     Boolean        @default(false)
  order      Int            @default(0)
  template   LessonTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers    Answer[]
  questions  Question[]
}

enum LessonStatus {
  PLANNED
  DONE
  CANCELLED
  MISSED
}

model LessonInstance {
  id          String          @id @default(cuid())
  templateId  String?
  studentId   String?
  groupId     String?
  startsAt    DateTime
  durationMin Int             @default(60)
  status      LessonStatus    @default(PLANNED)
  isTrial     Boolean         @default(false)
  trialName   String? // пробный урок с человеком, которого ещё нет в учениках
  price       Int? // стоимость урока на момент проведения, ₽
  charged     Boolean         @default(true) // для пропуска: списывать ли урок
  seriesId    String? // уроки одной еженедельной серии
  movedFrom   DateTime? // перенесён с этого времени
  teacherId   String? // владелец урока (нужно для пробных без ученика)
  note        String? // заметка учителя к уроку → видна в «Сегодня»
  recurrence  String? // правило повтора (RRULE) или null
  live        Json            @default("{}") // состояние класса: рубрика, «показать ученику», скрытые задания, таймер, доска заблокирована…
  billedAt    DateTime? // постоплата: урок включён в счёт
  deductedAt  DateTime? // абонемент: урок списан
  board       Json            @default("{\"pages\":[[]]}") // доска: страницы с объектами
  studentNote String? // заметки ученика к уроку
  startedAt   DateTime?
  finishedAt  DateTime?
  callLink    String?
  createdAt   DateTime        @default(now())
  template    LessonTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  student     Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group       Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  answers     Answer[]
  homework    Homework?
  feedback    Feedback[]

  @@index([startsAt])
  @@index([studentId, startsAt])
  @@index([teacherId, startsAt])
  @@index([seriesId])
}

enum AnswerStatus {
  DRAFT
  SUBMITTED
  AUTO_CHECKED
  NEEDS_REVIEW
  REVIEWED
}

model Answer {
  id               String         @id @default(cuid())
  lessonInstanceId String
  taskId           String
  studentId        String
  payload          Json           @default("{}")
  attempts         Int            @default(0)
  status           AnswerStatus   @default(DRAFT)
  aiDraft          Json?
  teacherReview    Json?
  shownToStudent   Boolean        @default(false)
  updatedAt        DateTime       @updatedAt
  lessonInstance   LessonInstance @relation(fields: [lessonInstanceId], references: [id], onDelete: Cascade)
  task             Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonInstanceId, taskId, studentId])
}

enum HomeworkStatus {
  ASSIGNED
  SUBMITTED
  REVIEWED
  NOT_DONE
}

model Homework {
  id               String         @id @default(cuid())
  lessonInstanceId String         @unique
  taskIds          String[]
  dueAt            DateTime?
  status           HomeworkStatus @default(ASSIGNED)
  teacherComment   String?
  extraTaskIds     String[] // задания урока, отправленные в домашку во время занятия
  wordTraining     String[] // «new» — тренировать новые слова, «review» — общее повторение
  lessonInstance   LessonInstance @relation(fields: [lessonInstanceId], references: [id], onDelete: Cascade)
}

// ───────────── Слова и маршрут ─────────────

model Word {
  id             String    @id @default(cuid())
  studentId      String
  word           String
  translation    String?
  definition     String?
  example        String?
  ownExample     String?
  level          Int       @default(0) // 0–4
  sourceLessonId String?
  nextReviewAt   DateTime?
  createdAt      DateTime  @default(now())
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Roadmap {
  id          String       @id @default(cuid())
  studentId   String
  type        String
  goal        String // A1+ … C2
  deadline    DateTime?
  showDate    Boolean      @default(false)
  pace        String?
  stages      Json         @default("[]")
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]
}

model Checkpoint {
  id        String   @id @default(cuid())
  roadmapId String
  kind      String // entry | slice
  takenAt   DateTime @default(now())
  results   Json     @default("{}") // по навыкам
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

// ───────────── Оплаты ─────────────

model Pack {
  id           String    @id @default(cuid())
  studentId    String
  lessonsTotal Int
  lessonsLeft  Int
  price        Int
  startsAt     DateTime  @default(now())
  frozenUntil  DateTime?
  invoiceId    String?   @unique // абонемент создан оплатой этого счёта
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  SENT
  PROOF_SENT
  PAID
  CANCELLED
}

model Invoice {
  id           String        @id @default(cuid())
  studentId    String
  amount       Int
  period       String?
  status       InvoiceStatus @default(SENT)
  proofKind    String? // screenshot | text
  proofFile    String?
  proofText    String?
  aiRead       Json?
  autoAccepted Boolean       @default(false)
  receiptFile  String?
  closedAt     DateTime? // учитель отметил «ОК» в проверке оплат
  kind         String        @default("lessons") // lessons — за проведённые уроки | pack — новый абонемент | manual — вручную
  title        String? // «Абонемент, 10 занятий» / «Урок 13 окт, 20:00»
  lessonIds    String[] // уроки, за которые выставлен счёт (постоплата)
  packLessons  Int? // сколько уроков в оплачиваемом абонементе
  payerName    String? // счёт другому лицу (например, родителю)
  payerContact String?
  proofAt      DateTime?
  paidAt       DateTime?
  remindedAt   DateTime?
  remindCount  Int           @default(0)
  createdAt    DateTime      @default(now())
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([status, createdAt])
}

// ───────────── Общение ─────────────

model Message {
  id         String    @id @default(cuid())
  studentId  String // переписка учитель ↔ конкретный ученик
  senderId   String
  text       String
  attachment String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sender     User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model Question {
  id            String    @id @default(cuid())
  studentId     String
  taskId        String?
  context       String? // курс · юнит · урок
  text          String
  aiAnswer      String?
  teacherAnswer String?
  askedTeacher  Boolean   @default(false)
  answeredAt    DateTime?
  createdAt     DateTime  @default(now())
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  action    String? // reply | check_screenshot | decide | review …
  link      String?
  readAt    DateTime?
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Feedback {
  id               String          @id @default(cuid())
  studentId        String
  lessonInstanceId String?
  text             String
  period           String?
  createdAt        DateTime        @default(now())
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonInstance   LessonInstance? @relation(fields: [lessonInstanceId], references: [id], onDelete: SetNull)
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  subject   String? // studentId / lessonInstanceId
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Загруженные файлы (картинки, аудио, видео, PDF, чеки). Хранилище: локальная папка или S3.
model Upload {
  id        String   @id @default(cuid())
  ownerId   String
  path      String   @unique // ключ в хранилище
  name      String
  mime      String
  size      Int
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// Сколько слов ученик потренировал за день — для цели дня и серии «дней подряд».
model WordPractice {
  id        String  @id @default(cuid())
  studentId String
  day       String // YYYY-MM-DD в поясе ученика
  count     Int     @default(0)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, day])
}

// ───────────── ИИ ─────────────

/// Каждый вызов ИИ-шлюза: для лимитов по тарифу и учёта расходов.
model AiCall {
  id        String   @id @default(cuid())
  teacherId String? // чей лимит расходуется (у ученика — его преподаватель)
  userId    String?
  kind      String // help | file | book | explain | draft | essay | alt | partner | speech | stt | tts | ocr | pay
  provider  String
  model     String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  ms        Int      @default(0)
  ok        Boolean  @default(true)
  cached    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
}

/// Кэш общих результатов (слова урока, распознанный учебник, одинаковые запросы).
model AiCache {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
}
