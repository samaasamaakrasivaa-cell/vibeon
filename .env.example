# VibeOn — шаблон настроек. Скопировать в .env и заполнить. Файл .env никому не отправлять.
NODE_ENV=development
APP_DOMAIN=localhost:3000
APP_URL=http://localhost:3000
SERVER_IP=

DATABASE_URL=postgresql://vibeon:vibeon@localhost:5432/vibeon
REDIS_URL=redis://localhost:6379
AUTH_SECRET=сгенерировать_длинную_случайную_строку

# Почта (для разработки — Mailpit на localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VibeOn <no-reply@vibeon.ru>"

# ИИ: mock | yandex | gigachat | anthropic_gateway
AI_PROVIDER=mock
YANDEX_CLOUD_FOLDER_ID=
YANDEX_CLOUD_API_KEY=
GIGACHAT_AUTH_KEY=
AI_GATEWAY_URL=
AI_MONTHLY_LIMIT_PER_TEACHER=

# Вход через Яндекс и VK (необязательно на старте)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Telegram-бот уведомлений (необязательно на старте)
TELEGRAM_BOT_TOKEN=

# Хранилище файлов (для разработки — локальная папка)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Оплата подписки учителей (тестовый режим)
PAYMENTS_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TRIAL_DAYS=14

# Видеозвонок: external_link | livekit
VIDEO_MODE=external_link

# База для docker-compose.yml на сервере (DATABASE_URL для контейнера собирается из этих значений)
POSTGRES_USER=vibeon
POSTGRES_PASSWORD=сгенерировать_надёжный_пароль
POSTGRES_DB=vibeon

# Плановые задачи оплат (счета, напоминания) идут внутри приложения раз в минуту.
# CRON_SECRET — ключ для ручного запуска POST /api/cron/billing (заголовок x-cron-key).
CRON_SECRET=
